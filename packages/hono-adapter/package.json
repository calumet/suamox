{
  "name": "@calumet/suamox-hono-adapter",
  "version": "0.4.0",
  "description": "Hono server adapter for Suamox framework",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepack": "pnpm build",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "hono",
    "server",
    "adapter",
    "ssr"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@calumet/suamox": "workspace:^",
    "hono": "^4.0.0",
    "vite": "^6.0.0 || ^7.0.0 || ^8.0.0"
  },
  "dependencies": {
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@calumet/suamox": "workspace:^",
    "@hono/node-server": "^2.0.10",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^4.1.10",
    "hono": "^4.12.31",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
