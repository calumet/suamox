{
  "name": "example-basic",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir dist/server && node -e \"import('@calumet/suamox/ssg').then((m) => m.runSsg()).catch((err) => { console.error(err); process.exit(1); })\"",
    "preview": "cross-env NODE_ENV=production tsx server.ts",
    "start": "cross-env NODE_ENV=production tsx server.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@calumet/suamox-head": "workspace:*",
    "@calumet/suamox-hono-adapter": "workspace:*",
    "@calumet/suamox-router": "workspace:*",
    "@calumet/suamox": "workspace:*",
    "@calumet/suamox-vite-plugin-pages": "workspace:*",
    "hono": "^4.13.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "cross-env": "^10.1.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
