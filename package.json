{
  "name": "suamox",
  "version": "0.1.0",
  "description": "Meta-framework with SSR/SSG, filesystem routing, and islands architecture",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter \"@calumet/suamox*\" build",
    "dev": "pnpm --parallel --filter \"@calumet/suamox*\" dev",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint --report-unused-disable-directives-severity=error",
    "format": "oxfmt",
    "test:e2e": "playwright test"
  },
  "keywords": [
    "framework",
    "ssr",
    "ssg",
    "react",
    "vite",
    "hono"
  ],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.14.0",
  "devDependencies": {
    "@calumet/elise-linter": "^0.9.0",
    "@calumet/suamox": "workspace:*",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
